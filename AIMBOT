--------------------------------------------------------------------------------
-- LOGIC TÌM & KHÓA MỤC TIÊU
--------------------------------------------------------------------------------
local function getAimPart(char)
	if not char then return nil end
	if State.AimPartName == "Head" then
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	else
		return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
	end
end

local function isValidTarget(player)
	if not player or player == LocalPlayer then return false end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local aimPart = getAimPart(char)
	local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not char or not hum or hum.Health <= 0 or not aimPart or not myHRP then
		return false
	end

	local dist = (aimPart.Position - myHRP.Position).Magnitude
	return dist <= State.MaxDistance
end

local function findBestTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local viewportCenter = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	local bestPlayer = nil
	local bestScore = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if isValidTarget(p) then
			local aimPart = getAimPart(p.Character)
			local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
			if onScreen and screenPos.Z > 0 then
				local centerDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
				if centerDist < bestScore then
					bestScore = centerDist
					bestPlayer = p
				end
			end
		end
	end

	return bestPlayer
end

local function setLockEnabled(enabled)
	if not State.Unlocked then return end
	State.LockEnabled = enabled

	if enabled then
		ToggleBtn.Text = "★ LOCK-ON: ON [NHẤN E]"
		TweenService:Create(ToggleBtn, TweenInfo.new(0.14), {
			BackgroundColor3 = Color3.fromRGB(115, 25, 45),
			BackgroundTransparency = 0.12
		}):Play()
		TweenService:Create(toggleStroke, TweenInfo.new(0.14), {
			Color = Color3.fromRGB(255, 70, 100),
			Thickness = 2.2
		}):Play()

		State.CurrentTarget = findBestTarget()

		if State.LockConn then State.LockConn:Disconnect() end
		State.LockConn = RunService.RenderStepped:Connect(function()
			if not State.Unlocked or not State.LockEnabled then return end
			local cam = workspace.CurrentCamera
			if not cam then return end

			if not isValidTarget(State.CurrentTarget) then
				State.CurrentTarget = findBestTarget()
			end

			local target = State.CurrentTarget
			local aimPart = target and getAimPart(target.Character)
			if target and aimPart then
				local camPos = cam.CFrame.Position
				local desiredCF = CFrame.lookAt(camPos, aimPart.Position)
				cam.CFrame = cam.CFrame:Lerp(desiredCF, State.Smoothness)

				local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
				if onScreen and screenPos.Z > 0 then
					TargetReticle.Visible = true
					TargetReticle.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
					local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
					local hp = hum and math.floor(hum.Health) or 0
					TargetTag.Text = string.format("%s | HP: %d", target.DisplayName, hp)
				else
					TargetReticle.Visible = false
				end

				StatusLbl.Text = "Đang khóa: " .. target.DisplayName
			else
				TargetReticle.Visible = false
				StatusLbl.Text = "Không có mục tiêu trong tầm"
			end
		end)
	else
		State.CurrentTarget = nil
		TargetReticle.Visible = false
		ToggleBtn.Text = "LOCK-ON: OFF [NHẤN E]"
		StatusLbl.Text = "Nhấn E để bật / tắt khóa mục tiêu"

		if State.LockConn then
			State.LockConn:Disconnect()
			State.LockConn = nil
		end

		TweenService:Create(ToggleBtn, TweenInfo.new(0.14), {
			BackgroundColor3 = Color3.fromRGB(45, 48, 60),
			BackgroundTransparency = 0.25
		}):Play()
		TweenService:Create(toggleStroke, TweenInfo.new(0.14), {
			Color = Color3.fromRGB(255, 255, 255),
			Thickness = 1.8
		}):Play()
	end
end

--------------------------------------------------------------------------------
-- XÁC THỰC MẬT KHẨU
--------------------------------------------------------------------------------
local function shakeAuthCard()
	local basePos = AuthCard.Position
	for i = 1, 4 do
		local offsetX = (i % 2 == 0) and -8 or 8
		AuthCard.Position = basePos + UDim2.new(0, offsetX, 0, 0)
		task.wait(0.04)
	end
	AuthCard.Position = basePos
end

local function attemptUnlock()
	local entered = string.gsub(PassBox.Text, "^%s*(.-)%s*$", "%1")
	if entered == CORRECT_PASS then
		State.Unlocked = true
		AuthStatus.TextColor3 = Color3.fromRGB(120, 255, 165)
		AuthStatus.Text = "Mật khẩu chính xác!"
		task.wait(0.2)
		LockBackdrop.Visible = false
		Panel.Visible = true
	else
		AuthStatus.TextColor3 = Color3.fromRGB(255, 85, 110)
		AuthStatus.Text = "Sai mật khẩu, thử lại nhé!"
		TweenService:Create(authStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 40, 70)}):Play()
		task.spawn(shakeAuthCard)
		task.delay(0.5, function()
			if authStroke then
				TweenService:Create(authStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 255, 255)}):Play()
			end
		end)
	end
end

UnlockBtn.MouseButton1Click:Connect(attemptUnlock)
PassBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		attemptUnlock()
	end
end)

ToggleBtn.MouseButton1Click:Connect(function()
	setLockEnabled(not State.LockEnabled)
end)

PartBtn.MouseButton1Click:Connect(function()
	if not State.Unlocked then return end
	if State.AimPartName == "Head" then
		State.AimPartName = "HumanoidRootPart"
		PartBtn.Text = "MỤC TIÊU: BODY"
	else
		State.AimPartName = "Head"
		PartBtn.Text = "MỤC TIÊU: HEAD"
	end
end)

DistBox.FocusLost:Connect(function()
	local num = tonumber(string.match(DistBox.Text, "%d+"))
	if num then
		State.MaxDistance = math.clamp(num, 20, 1500)
	end
	DistBox.Text = "Tầm: " .. tostring(State.MaxDistance)
end)

--------------------------------------------------------------------------------
-- PHÍM TẮT PC (E & CTRL) + CHẠM 2 LẦN TRÊN ĐIỆN THOẠI
--------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not State.Unlocked then return end

	-- Chạm 2 lần liên tiếp trên điện thoại (Touch) để ẩn/hiện menu
	if input.UserInputType == Enum.UserInputType.Touch and not gameProcessed then
		local now = os.clock()
		local tapPos = Vector2.new(input.Position.X, input.Position.Y)
		if (now - State.LastTapTime) <= 0.35 and (tapPos - State.LastTapPos).Magnitude <= 85 then
			Panel.Visible = not Panel.Visible
			State.LastTapTime = 0
		else
			State.LastTapTime = now
			State.LastTapPos = tapPos
		end
		return
	end

	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.E then
		setLockEnabled(not State.LockEnabled)
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		Panel.Visible = not Panel.Visible
	end
end)
