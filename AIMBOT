local maxDist = 250
local aimPartName = "Head"
local conn = nil
local lastTap = 0
local lastPos = Vector2.zero

local function getCam()
	return workspace.CurrentCamera
end

local function getPart(char)
	if not char then return nil end
	return char:FindFirstChild(aimPartName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getTarget()
	local cam = getCam()
	local myChar = lp.Character
	local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
	if not cam or not myRoot then return nil end

	local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	local best, bestDist = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local part = getPart(plr.Character)
			if hum and hum.Health > 0 and part then
				local worldDist = (part.Position - myRoot.Position).Magnitude
				if worldDist <= maxDist then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and sp.Z > 0 then
						local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if d < bestDist then
							bestDist = d
							best = part
						end
					end
				end
			end
		end
	end
	return best
end

