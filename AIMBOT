local function setLock(state)
	if not unlocked then return end
	locking = state
	statusBtn.Text = locking and "LOCK: ON [PHIM E]" or "LOCK: OFF [PHIM E]"
	statusBtn.BackgroundColor3 = locking and Color3.fromRGB(220, 45, 75) or Color3.fromRGB(45, 49, 62)

	if conn then
		conn:Disconnect()
		conn = nil
	end

	if locking then
		conn = RunService.RenderStepped:Connect(function()
			if not locking then return end
			local cam = getCam()
			local part = getTarget()
			if cam and part then
				local targetCF = CFrame.lookAt(cam.CFrame.Position, part.Position)
				cam.CFrame = cam.CFrame:Lerp(targetCF, 0.35)
			end
		end)
	end
end

local function checkPass()
	local txt = string.gsub(passBox.Text, "^%s*(.-)%s*$", "%1")
	if txt == PASS then
		unlocked = true
		authFrame.Visible = false
		panel.Visible = true
	else
		msgLbl.Text = "Sai mat khau!"
	end
end

unlockBtn.MouseButton1Click:Connect(checkPass)
passBox.FocusLost:Connect(function(enter)
	if enter then checkPass() end
end)

statusBtn.MouseButton1Click:Connect(function()
	setLock(not locking)
end)

partBtn.MouseButton1Click:Connect(function()
	aimPartName = (aimPartName == "Head") and "HumanoidRootPart" or "Head"
	partBtn.Text = (aimPartName == "Head") and "AIM: HEAD" or "AIM: BODY"
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if not unlocked then return end

	if input.UserInputType == Enum.UserInputType.Touch and not gp then
		local now = os.clock()
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if (now - lastTap) <= 0.35 and (pos - lastPos).Magnitude <= 85 then
			panel.Visible = not panel.Visible
			lastTap = 0
		else
			lastTap = now
			lastPos = pos
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then return end

	if input.KeyCode == Enum.KeyCode.E then
		setLock(not locking)
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		panel.Visible = not panel.Visible
	end
end)
