local function applyGlass(instance, radius, strokeThick, bgTrans, baseCol)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 14)
	corner.Parent = instance

	instance.BackgroundColor3 = baseCol or Color3.fromRGB(30, 33, 42)
	instance.BackgroundTransparency = bgTrans or 0.22

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(225, 230, 242)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 110, 135))
	})
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.14),
		NumberSequenceKeypoint.new(0.5, 0.26),
		NumberSequenceKeypoint.new(1, 0.18)
	})
	grad.Rotation = 35
	grad.Parent = instance

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = strokeThick or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.2
	stroke.Parent = instance

	local sGrad = Instance.new("UIGradient")
	sGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 65, 95)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 210, 220))
	})
	sGrad.Rotation = 120
	sGrad.Parent = stroke

	return stroke
end

